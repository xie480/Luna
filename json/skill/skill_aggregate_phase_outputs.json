{
  "name": "aggregate_phase_outputs",
  "description": "聚合阶段节点输出，为下一阶段提供结构化上下文",
  "version": "1.0.0",
  "owner": "openclaw",
  "beanName": "planNodeTools",
  "methodName": "listPhaseNodes",
  "inputSchema": "{\"type\":\"object\",\"properties\":{\"planId\":{\"type\":\"string\"},\"phaseId\":{\"type\":\"string\"}},\"required\":[\"planId\",\"phaseId\"]}",
  "outputSchema": "{\"type\":\"object\",\"properties\":{\"status\":{\"type\":\"string\"},\"data\":{\"type\":\"array\"}}}",
  "runMode": "SYNC",
  "requiredCapabilities": [
    "LIST_PHASE_NODES",
    "APPEND_NODE_OUTPUT"
  ],
  "toolSlots": [
    {
      "slot": "list_nodes",
      "capability": "LIST_PHASE_NODES",
      "required": true
    },
    {
      "slot": "append_summary",
      "capability": "APPEND_NODE_OUTPUT",
      "required": false
    }
  ],
  "thoughtChain": [
    "读取阶段全部节点输出",
    "提取可传递给下游的关键字段",
    "生成阶段聚合摘要供后续节点使用"
  ]
}
