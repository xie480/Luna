{
  "name": "generate_task_report_and_open",
  "description": "对指定计划执行收尾，生成HTML任务报告并尝试自动打开浏览器展示，适用于成功与失败场景统一出报告。",
  "version": "1.1.0",
  "owner": "openclaw",
  "beanName": "planOrchestratorServiceImpl",
  "methodName": "finalizeAndReport",
  "inputSchema": "{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"planId\":{\"type\":\"string\",\"minLength\":1,\"description\":\"计划ID\"}},\"required\":[\"planId\"]}",
  "outputSchema": "{\"type\":\"object\",\"properties\":{\"status\":{\"type\":\"string\"},\"planId\":{\"type\":\"string\"},\"finalStatus\":{\"type\":\"string\",\"description\":\"最终状态：SUCCESS/FAILED/PARTIAL/CANCELLED\"},\"writeResult\":{\"type\":\"object\",\"description\":\"报告写入结果\"},\"openResult\":{\"type\":\"object\",\"description\":\"浏览器唤起结果\"}}}",
  "runMode": "SYNC",
  "requiredCapabilities": [
    "WRITE_HTML_REPORT_FILE",
    "OPEN_BROWSER_WITH_FILE",
    "RECORD_PLAN_AUDIT_LOG",
    "EMIT_PLAN_EVENT_SSE"
  ],
  "toolSlots": [
    {
      "slot": "write_report",
      "capability": "WRITE_HTML_REPORT_FILE",
      "required": true
    },
    {
      "slot": "open_report",
      "capability": "OPEN_BROWSER_WITH_FILE",
      "required": false
    },
    {
      "slot": "audit_log",
      "capability": "RECORD_PLAN_AUDIT_LOG",
      "required": true
    },
    {
      "slot": "emit_report_event",
      "capability": "EMIT_PLAN_EVENT_SSE",
      "required": true
    }
  ],
  "thoughtChain": [
    "汇总计划与节点执行结果",
    "生成并写入HTML报告文件",
    "记录审计、推送事件并尝试自动打开报告"
  ]
}
