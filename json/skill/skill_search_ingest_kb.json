{
  "name": "search_ingest_kb",
  "description": "搜索即入库技能。先搜索并抓取目标内容，再按规则清洗并写入知识库，形成可持续复用的 RAG 资产。",
  "version": "1.0.0",
  "owner": "System",
  "beanName": "orchestrationSkills",
  "methodName": "searchIngestKnowledgeBase",
  "runMode": "ASYNC",
  "requiredCapabilities": [
    "WEB_SEARCH",
    "WEB_FETCH",
    "KB_INSERT"
  ],
  "toolSlots": [
    {
      "slot": "search",
      "capability": "WEB_SEARCH",
      "required": true
    },
    {
      "slot": "fetch",
      "capability": "WEB_FETCH",
      "required": true
    },
    {
      "slot": "kb",
      "capability": "KB_INSERT",
      "required": true
    }
  ],
  "thought_chain": [
    "解析 query、kbTitle、sourceType、maxFetch、deduplicate，补全默认值。",
    "调用【search】槽位对应的搜索能力获取候选来源。",
    "筛选候选来源，按相关性、时效性、可访问性和重复度截断。",
    "对需要深度内容的来源调用【fetch】槽位提取正文。",
    "清洗正文并进行去重，生成入库标题。",
    "调用【kb】槽位对应的写入能力批量入库。",
    "返回 insertedCount、skippedCount 和 sourceList。"
  ]
}
