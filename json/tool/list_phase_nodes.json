{
  "name": "list_phase_nodes",
  "description": "列出指定 planId + phaseId 下的节点列表和状态。",
  "version": "1.0.0",
  "owner": "System",
  "beanName": "openClawTools",
  "methodName": "listPhaseNodes",
  "inputSchema": {
    "type": "object",
    "properties": {
      "planId": { "type": "string" },
      "phaseId": { "type": "string" }
    },
    "required": ["planId", "phaseId"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": { "type": "string" },
      "data": { "type": "array" }
    }
  }
}
