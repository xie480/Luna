{
  "name": "acquire_execution_lock",
  "description": "获取执行锁以避免并行冲突。适用于同一资源（窗口、文件、应用实例）不可重入场景。调用方应提供 lockKey 与 owner，必要时设置 ttlSec 防止死锁。当前实现已接入 Redis 分布式锁（SET NX EX），并返回锁到期时间，失败时会返回 currentOwner 供上层调度重试。",
  "version": "1.0.0",
  "owner": "System",
  "beanName": "executionLockTools",
  "methodName": "acquireExecutionLock",
  "inputSchema": {
    "type": "object",
    "properties": {
      "lockKey": { "type": "string" },
      "owner": { "type": "string" },
      "ttlSec": { "type": "integer" }
    },
    "required": ["lockKey", "owner"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": { "type": "string" },
      "data": { "type": "object" }
    }
  }
}
