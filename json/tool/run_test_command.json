{
  "name": "run_test_command",
  "description": "执行测试命令并返回结构化摘要。适用于代码改动后的质量验证、失败回归与自动修复闭环。调用方应传入 workDir 与测试命令（如 mvn test / gradle test），并设置 timeoutSec 防止卡死。返回包含 exitCode、输出片段与耗时，便于后续失败归因。",
  "version": "1.0.0",
  "owner": "System",
  "beanName": "codeOpsTools",
  "methodName": "runTestCommand",
  "inputSchema": {
    "type": "object",
    "properties": {
      "workDir": { "type": "string" },
      "command": { "type": "string" },
      "timeoutSec": { "type": "integer" }
    },
    "required": ["workDir", "command"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": { "type": "string" },
      "data": { "type": "object" }
    }
  }
}
