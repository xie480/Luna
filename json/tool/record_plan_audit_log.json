{
  "name": "record_plan_audit_log",
  "description": "记录计划执行审计事件。用于沉淀阶段切换、节点执行、重规划、审批请求与结果等关键轨迹，支撑可视化回放、问题排查与合规审计。eventType 与 level 必须使用系统枚举；eventPayload 建议传结构化 JSON，便于后续检索与统计分析。",
  "version": "1.0.0",
  "owner": "System",
  "beanName": "planEventTools",
  "methodName": "recordPlanAuditLog",
  "inputSchema": {
    "type": "object",
    "properties": {
      "planId": { "type": "string" },
      "phaseId": { "type": "string" },
      "nodeId": { "type": "string" },
      "level": { "type": "string", "enum": ["INFO", "WARN", "ERROR"] },
      "eventType": {
        "type": "string",
        "enum": [
          "PLAN_CREATED",
          "PLAN_PHASE_STARTED",
          "PLAN_PHASE_FINISHED",
          "PLAN_NODE_RUNNING",
          "PLAN_NODE_SUCCESS",
          "PLAN_NODE_FAILED",
          "PLAN_REPLANNED",
          "PLAN_FINISHED",
          "PLAN_REPORT_READY",
          "PLAN_CODE_PATCH_READY",
          "PLAN_TEST_RESULT",
          "APPROVAL_REQUEST",
          "APPROVAL_RESULT"
        ]
      },
      "eventPayload": { "type": "string", "description": "JSON字符串" },
      "traceId": { "type": "string" }
    },
    "required": ["planId", "level", "eventType", "eventPayload"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": { "type": "string" },
      "data": { "type": "object" }
    }
  }
}
