{
  "name": "read_source_file",
  "description": "读取源码文件内容。",
  "version": "1.0.0",
  "owner": "System",
  "beanName": "codeOpsTools",
  "methodName": "readSourceFile",
  "inputSchema": {
    "type": "object",
    "properties": {
      "filePath": { "type": "string" },
      "encoding": { "type": "string" },
      "maxBytes": { "type": "integer" }
    },
    "required": ["filePath"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": { "type": "string" },
      "data": { "type": "object" }
    }
  }
}
