{
  "name": "collect_test_report",
  "description": "聚合测试报告目录，返回结构化测试结果（当前为基础实现）。",
  "version": "1.0.0",
  "owner": "System",
  "beanName": "codeOpsTools",
  "methodName": "collectTestReport",
  "inputSchema": {
    "type": "object",
    "properties": {
      "reportDirs": { "type": "string", "description": "目录列表JSON字符串或逗号分隔" },
      "parserType": { "type": "string", "enum": ["junit", "surefire", "auto"] }
    },
    "required": ["reportDirs"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": { "type": "string" },
      "data": { "type": "object" }
    }
  }
}
