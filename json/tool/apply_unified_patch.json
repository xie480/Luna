{
  "name": "apply_unified_patch",
  "description": "应用 unified diff 补丁到目标仓库。用于在代码修复链路中将模型生成的 patch 安全落地。支持 checkOnly 预检模式：仅校验补丁可应用性，不实际修改文件。当前实现已基于 git apply 落地，返回 checkOnlyResult、exitCode、stdoutTail、stderrTail 等关键字段，便于上层自动决策。",
  "version": "1.0.0",
  "owner": "System",
  "beanName": "codeOpsTools",
  "methodName": "applyUnifiedPatch",
  "inputSchema": {
    "type": "object",
    "properties": {
      "repoPath": { "type": "string" },
      "patchText": { "type": "string" },
      "checkOnly": { "type": "boolean" }
    },
    "required": ["repoPath", "patchText"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": { "type": "string" },
      "data": { "type": "object" }
    }
  }
}
