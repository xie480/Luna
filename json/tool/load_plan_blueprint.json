{
  "name": "load_plan_blueprint",
  "description": "读取并校验指定计划蓝图版本。若传入 planVersion 则精确读取该版本；不传则读取最新版本。返回包含 blueprintJson、来源信息与校验结果。校验失败会返回错误信息，并写入审计事件（PLAN_BLUEPRINT_INVALID）；校验通过会写入 PLAN_BLUEPRINT_VALIDATED，并可通过 SSE 推送结果。",
  "version": "1.1.0",
  "owner": "System",
  "beanName": "planBlueprintTools",
  "methodName": "loadPlanBlueprint",
  "inputSchema": {
    "type": "object",
    "properties": {
      "planId": { "type": "string", "description": "计划ID（必填）" },
      "planVersion": { "type": "integer", "description": "计划版本（可选）" }
    },
    "required": ["planId"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": { "type": "string" },
      "data": { "type": "object" },
      "message": { "type": "string" }
    }
  }
}
