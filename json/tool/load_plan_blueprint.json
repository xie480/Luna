{
  "name": "load_plan_blueprint",
  "description": "读取指定计划的蓝图版本。用于阶段执行开始前加载冻结规划，或用于失败恢复时重建任务拓扑。若传入 planVersion，则精确读取该版本；若不传则读取最新版本。返回中会包含 blueprintJson 与来源标识，便于执行层判定是否可直接进入阶段调度。",
  "version": "1.0.0",
  "owner": "System",
  "beanName": "planBlueprintTools",
  "methodName": "loadPlanBlueprint",
  "inputSchema": {
    "type": "object",
    "properties": {
      "planId": { "type": "string", "description": "计划ID（必填）" },
      "planVersion": { "type": "integer", "description": "计划版本（可选）" }
    },
    "required": ["planId"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": { "type": "string" },
      "data": { "type": "object" }
    }
  }
}
