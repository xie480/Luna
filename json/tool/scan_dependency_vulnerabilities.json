{
  "name": "scan_dependency_vulnerabilities",
  "description": "执行依赖漏洞扫描（SCA），用于识别项目依赖中的已知安全风险。支持指定生态（maven/gradle/npm/pnpm/yarn/python/auto）与失败阈值（failOnSeverity）。当前实现会根据生态自动选择扫描命令并尝试汇总报告，返回 summary 与 thresholdReached 供上层决策。",
  "version": "1.1.0",
  "owner": "System",
  "beanName": "codeOpsTools",
  "methodName": "scanDependencyVulnerabilities",
  "inputSchema": {
    "type": "object",
    "properties": {
      "repoPath": { "type": "string" },
      "ecosystem": { "type": "string", "enum": ["maven", "gradle", "npm", "pnpm", "yarn", "python", "auto"] },
      "failOnSeverity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] }
    },
    "required": ["repoPath"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": { "type": "string" },
      "data": { "type": "object" }
    }
  }
}
