{
  "name": "scan_dependency_vulnerabilities",
  "description": "执行依赖漏洞扫描（SCA），用于识别项目依赖中的已知安全风险。支持指定生态（maven/npm/pip/auto）与失败阈值（failOnSeverity）。当前实现为环境未启用状态：已提供统一接口与错误返回，但需先按 docs/openclaw_tool_dependency_guide.md 安装并接入外部 SCA 工具后才能返回真实扫描结果。",
  "version": "1.0.0",
  "owner": "System",
  "beanName": "codeOpsTools",
  "methodName": "scanDependencyVulnerabilities",
  "inputSchema": {
    "type": "object",
    "properties": {
      "repoPath": { "type": "string" },
      "ecosystem": { "type": "string", "enum": ["maven", "npm", "pip", "auto"] },
      "failOnSeverity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] }
    },
    "required": ["repoPath"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": { "type": "string" },
      "data": { "type": "object" }
    }
  }
}
