{
  "name": "detect_ui_elements",
  "description": "识别截图中的 UI 元素（文本、控件、区域）并返回结构化结果，服务于桌面任务定位与自动化操作决策。可指定 detectorType（ocr/uiautomation/hybrid）与 targetHints 提高识别准确度。当前为占位实现，后续建议补充坐标标准化与置信度字段。",
  "version": "1.0.0",
  "owner": "System",
  "beanName": "desktopTools",
  "methodName": "detectUiElements",
  "inputSchema": {
    "type": "object",
    "properties": {
      "imagePath": { "type": "string" },
      "detectorType": { "type": "string", "enum": ["ocr", "uiautomation", "hybrid"] },
      "targetHints": { "type": "string" }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "status": { "type": "string" },
      "data": { "type": "object" }
    }
  }
}
